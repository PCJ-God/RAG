# DashScope API Key（百炼平台，调用 LLM / Embedding / Rerank）
# 获取地址: https://bailian.console.aliyun.com/?apiKey=1
DASHSCOPE_API_KEY=sk-your-api-key-here

# 模型配置
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=qwen3-rerank

# 分块配置
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# 检索配置（先粗排召回 TOP_K，再精排到 RERANK_TOP_N）
TOP_K=20
RERANK_TOP_N=3

# 生成配置（问答助手追求准确，温度建议 0~0.3）
TEMPERATURE=0.1
MAX_TOKENS=1024

# 向量库：local（本地 JSON，默认）/ dashvector（阿里云向量检索服务）
VECTOR_STORE=local

# DashVector（VECTOR_STORE=dashvector 时必填）
# 注意：DashVector 的 API-KEY 与百炼的 API-KEY 是两套独立的，需在 DashVector 控制台单独获取
DASHSVECTOR_API_KEY=
DASHSVECTOR_ENDPOINT=
# 集合名，留空则自动用 "<domain>_knowledge"（如 rag_knowledge）
DASHSVECTOR_COLLECTION=
# 向量维度，text-embedding-v3 固定 1024，建库后不可改
DASHSVECTOR_DIM=1024
