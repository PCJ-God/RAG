# DashScope API Key (用于调用通义千问大模型)
# 获取地址: https://bailian.console.aliyun.com/?apiKey=1
DASHSCOPE_API_KEY=sk-your-api-key-here

# 模型配置
# 可选: qwen-turbo, qwen-plus, qwen-max, qwen3-235b-a22b-thinking-2507
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=qwen3-rerank

# RAG配置
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_TOP_K=5
RERANK_TOP_N=3

# 生成配置
TEMPERATURE=0.7
TOP_P=0.8
MAX_TOKENS=1024
