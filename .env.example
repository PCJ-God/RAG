# DashScope API Key（百炼平台，调用 LLM / Embedding / Rerank）
# 获取地址: https://bailian.console.aliyun.com/?apiKey=1
DASHSCOPE_API_KEY=sk-your-api-key-here

# 模型配置
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=qwen3-rerank

# 分块配置
CHUNK_SIZE=512
CHUNK_OVERLAP=50
# 语义切分断裂点阈值（0-100，越大切得越少；只对超长小节生效）
SEMANTIC_BREAKPOINT_THRESHOLD=95

# 检索配置（先粗排召回 TOP_K，再精排到 RERANK_TOP_N）
TOP_K=20
RERANK_TOP_N=3

# 追问澄清：意图不明确时最多追问几轮（仅交互式多轮会话生效）
CLARIFY_MAX_ROUNDS=3

# 生成配置（问答助手追求准确，温度建议 0~0.3）
TEMPERATURE=0.1
MAX_TOKENS=1024

# 向量库：local（本地 JSON，默认）/ dashvector（阿里云向量检索服务）
VECTOR_STORE=local

# DashVector（VECTOR_STORE=dashvector 时必填）
# 注意：DashVector 的 API-KEY 与百炼的 API-KEY 是两套独立的，需在 DashVector 控制台单独获取
DASHSVECTOR_API_KEY=
DASHSVECTOR_ENDPOINT=
# 集合名，留空则自动用 "<domain>_knowledge"（如 rag_knowledge）
DASHSVECTOR_COLLECTION=
# 向量维度，text-embedding-v3 固定 1024，建库后不可改
DASHSVECTOR_DIM=1024

# 多轮记忆（仅 dashvector 模式启用）
MEMORY_COLLECTION=chat_memory
MEMORY_TOP_K=4
MEMORY_WINDOW=3
USER_ID=default_user

# AI 安全护栏（阿里云内容安全/绿网；未配置 AccessKey 时自动禁用）
# 需使用 RAM 用户 AccessKey，与百炼 / DashVector 的 Key 相互独立
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
CONTENT_SECURITY_REGION=cn-shanghai
CONTENT_SECURITY_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
# 输入护栏检测服务（用户提问）
CONTENT_SECURITY_QUERY_SERVICE=llm_query_moderation
# 输出护栏检测服务（模型回答）
CONTENT_SECURITY_RESPONSE_SERVICE=llm_response_moderation
# 命中这些风险等级即拦截：high / medium / low（逗号分隔）
CONTENT_SECURITY_BLOCK_LEVELS=high,medium
